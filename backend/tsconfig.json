{
  "compilerOptions": {
    "module": "ESNext",               
    "target": "ESNext",               
    "moduleResolution": "node",       
    "esModuleInterop": true,          
    "skipLibCheck": true,             
    "outDir": "./dist",               
    "allowJs": true,                  
    "resolveJsonModule": true,        
    "isolatedModules": true,          
    "forceConsistentCasingInFileNames": true,
    "rootDir": "./src",
    "strict": true
  }, 
  "include": ["src/**/*"],
  "ts-node": {
    "experimentalSpecifierResolution": "node",
    "esm": true,
  },
}
